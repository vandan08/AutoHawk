# Required for AI scoring and cover letters (falls back to keyword scoring without it)
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-4-8)
AUTOHAWK_MODEL=

# Optional: Adzuna source (free keys at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: override SQLite database path (default: ./autohawk.db)
AUTOHAWK_DB=
