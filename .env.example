# --- LLM provider -----------------------------------------------------------
# auto (default): use Anthropic if a key is set, else Ollama if running,
#                 else free keyword scoring.
# Options: auto | anthropic | ollama | none
AUTOHAWK_PROVIDER=auto

# Anthropic (hosted, best quality — pay-per-use API, no subscription needed)
ANTHROPIC_API_KEY=
AUTOHAWK_MODEL=            # default: claude-opus-4-8

# Ollama (local, 100% free — https://ollama.com)
OLLAMA_HOST=               # default: http://localhost:11434
AUTOHAWK_OLLAMA_MODEL=     # default: llama3.1:8b (low RAM? try llama3.2:3b)

# --- Sources ------------------------------------------------------------------
# Adzuna (free keys at https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Storage ------------------------------------------------------------------
# Override SQLite database path (default: ./autohawk.db)
AUTOHAWK_DB=
